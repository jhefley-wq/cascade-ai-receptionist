# Cascade RV Solar Solutions — AI Receptionist Configuration
# Copy to .env for local use. Never commit .env, snapshots, or call data.

# Durable storage. Railway injects a PostgreSQL DATABASE_URL when a Postgres service
# is attached. SQLite is used only when this is absent, for local development.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# OpenAI (required for live conversation and post-call extraction)
OPENAI_API_KEY=sk-...your-openai-api-key-here...
# Current documented Realtime model; override only after staging validation.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Twilio (required for phone call handling)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Twilio webhook verification. Leave false only for an isolated local development
# server. Set true before exposing a staging or production endpoint.
TWILIO_VALIDATE_SIGNATURES=true
# Exact public HTTPS origin configured in Twilio, no trailing slash. This prevents
# reverse-proxy host/scheme rewriting from breaking HTTP webhook verification.
TWILIO_WEBHOOK_BASE_URL=https://your-staging-host.example
# Exact public WSS Media Stream URL generated in TwiML, no query parameters unless
# they are also configured in Twilio. Required when signature validation is enabled.
TWILIO_MEDIA_STREAM_URL=wss://your-staging-host.example/media-stream

# Required operator authentication. If either value is empty, /, /leads, and
# /toggle fail closed and do not show call or lead data.
ADMIN_USERNAME=change-this-admin-username
ADMIN_PASSWORD=use-a-long-unique-password

# Owner notification settings (optional; no customer data is logged at INFO level)
OWNER_EMAIL=owner@example.com
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Runtime
PORT=8000
LOG_LEVEL=INFO
